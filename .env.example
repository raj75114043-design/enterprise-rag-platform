APP_ENV=dev
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag
# key:role pairs; replace in any shared environment
API_KEYS=operator-key:operator,analyst-key:qa_analyst,head-key:qa_head
# lsa (offline, default) or fastembed (BAAI/bge-small-en-v1.5, downloads the model once)
EMBEDDINGS=lsa
# Optional open-weight LLM answer writer via Groq (free tier) or Ollama
# GROQ_API_KEY=
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
MIN_SUPPORT=0.5
TOP_K=5
